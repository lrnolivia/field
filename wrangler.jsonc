{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "field",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "FIELD_PROJECTS",
      "bucket_name": "field-projects"
    }
  ],
  "keep_vars": true
}
