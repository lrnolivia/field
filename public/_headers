/sandbox/*
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Origin-Agent-Cluster: ?1

/preview-sandbox/*
  Cross-Origin-Resource-Policy: cross-origin

/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/work/*
  Cache-Control: no-cache, no-store, must-revalidate
/builder/*
  Cache-Control: no-cache, no-store, must-revalidate
/sandbox/
  Cache-Control: no-cache, no-store, must-revalidate
/sandbox/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/preview/
  Cache-Control: no-cache, no-store, must-revalidate
/preview/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Content-hashed bundles: a new build gets new names, so these never change.
# (runtime-bridge*.js keep stable names and stay revalidated.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sandbox/assets/*
  Cache-Control: public, max-age=31536000, immutable
/preview-sandbox/assets/*
  Cache-Control: public, max-age=31536000, immutable
